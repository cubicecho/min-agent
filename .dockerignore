# Installed inside the image, for the image's own platform.
node_modules
**/node_modules

# Built inside the image.
dist
**/dist

# Secrets. Settings live in Postgres now, so this is the only runtime state left on disk,
# and baking it in would ship one machine's key to every other one.
.env
.env.local

# The Expo app. The server image does not build it — see the note in the Dockerfile —
# so none of it needs to travel to the daemon.
mobile
.expo

# Repo furniture with nothing to contribute to a build.
.git
.github
.claude
*.log
README.md
Dockerfile
docker-compose.yml
.dockerignore
