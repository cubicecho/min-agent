# Installed inside the image, for the image's own platform.
node_modules
**/node_modules

# Built inside the image.
dist
**/dist

# Secrets. Settings live in Postgres now, so this is the only runtime state left on disk,
# and baking it in would ship one machine's key to every other one.
.env
.env.local

# `mobile/` itself now travels to the daemon — the image builds the web export the server
# serves — but Metro's cache is per-machine, and the Electron shell is not in the image.
**/.expo
mobile/electron

# Repo furniture with nothing to contribute to a build.
.git
.github
.claude
*.log
README.md
Dockerfile
docker-compose.yml
.dockerignore
