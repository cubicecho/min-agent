{
  "name": "min-agent",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "mobile": "tsx --env-file-if-exists=.env scripts/expo.ts start",
    "mobile:web": "tsx --env-file-if-exists=.env scripts/expo.ts web",
    "mobile:android": "tsx --env-file-if-exists=.env scripts/expo.ts android",
    "mobile:export": "tsx --env-file-if-exists=.env scripts/expo.ts export:web",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "desktop": "npm run mobile:export && npm --prefix mobile/electron run start",
    "desktop:build": "npm run mobile:export && npm --prefix mobile/electron run dist",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "schema": "tsx scripts/print-schema.ts",
    "codegen": "npm run schema && graphql-codegen",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@vantreeseba/drizzle-graphql": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.22.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.37.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typed-document-node": "^6.1.8",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
