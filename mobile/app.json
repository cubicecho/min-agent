{
  "expo": {
    "name": "min-agent",
    "slug": "min-agent",
    "version": "1.0.0",
    "scheme": "minagent",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "lan.minagent.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-vector-icons/feather",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow min-agent to use the microphone so you can speak a message instead of typing it."
        }
      ]
    ]
  }
}
