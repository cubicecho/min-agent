# Copy to .env. Both `npm run dev` and `npm start` read it, so a value set here takes
# effect without being exported into your shell.

# Postgres. Everything min-agent keeps — settings, MCP servers, sessions — lives here, and
# the server applies its migrations on boot, so an empty database is the right starting
# point. `docker compose up -d db` brings one up at exactly this address.
DATABASE_URL=postgres://min_agent:min_agent@localhost:5432/min_agent
# Optional. An API key saved in Config wins; this is the fallback.
OPENAI_API_KEY=
# Express port. The Vite dev server proxies /graphql here, and the Android, desktop and
# Expo web builds are given this address at bundle time, so it is set in one place.
PORT=8787
# Interface to bind. The default accepts connections from the LAN, which is what the
# Android and desktop apps need. Set it to localhost to accept local connections only.
HOST=0.0.0.0
# Only for `npm test`. The store tests truncate every table at this address, so point it at
# a throwaway database — never at DATABASE_URL. Unset, those tests skip.
# TEST_DATABASE_URL=postgres://min_agent:min_agent@localhost:5432/min_agent_test
