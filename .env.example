# Copy to .env. Both `npm run dev` and `npm start` read it, so a value set here takes
# effect without being exported into your shell.

# Optional. config/llm.yaml wins; this is the fallback for the API key.
OPENAI_API_KEY=
# Express port. The Vite dev server proxies /api here, and the Android, desktop and
# Expo web builds are given this address at bundle time, so it is set in one place.
PORT=8787
# Interface to bind. The default accepts connections from the LAN, which is what the
# Android and desktop apps need. Set it to localhost to accept local connections only.
HOST=0.0.0.0
