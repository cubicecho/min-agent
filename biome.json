{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "server/**",
      "shared/**",
      "tests/**",
      "scripts/**",
      ".github/scripts/**",
      "mobile/app/**",
      "mobile/components/**",
      "mobile/lib/**",
      "mobile/scripts/**",
      "mobile/electron/main.js",
      "mobile/*.js",
      "mobile/*.mjs",
      "*.ts",
      "*.json",
      "!shared/gql",
      "!mobile/components/ui",
      "!mobile/components/*.tsx",
      "!mobile/lib/cubeui-theme.ts",
      "!mobile/lib/color.ts",
      "!mobile/lib/utils.ts",
      "!mobile/lib/web-as.d.ts",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "useBlockStatements": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
